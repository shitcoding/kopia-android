<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is permitted app-wide because storage backends are arbitrary
         user-specified hosts (a home NAS or self-hosted WebDAV/S3 on a LAN often has no TLS),
         and Android's network-security-config can only scope cleartext by domain — not by the
         runtime-entered endpoint. Restricting it here would break those legitimate self-hosted
         setups. The user-facing control is instead at the app layer: the connect/create UI defaults
         to https, warns on a cleartext (http:) endpoint, and the connect layer requires an explicit
         per-connection opt-in. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- User-installed CAs are trusted so a self-hoster who runs their storage backend
                 behind a private/self-signed CA can install it once on the device and then use
                 https instead of cleartext. Without this, API 24+ ignores user CAs and the ONLY
                 working configuration for that (common) deployment is plain http — i.e. omitting
                 this makes the app less secure in practice, not more. Installing a CA is a
                 deliberate, warned device-level action by the device owner, repository blobs are
                 client-side encrypted regardless, and per-connection certificate pinning
                 (WebDAV fingerprint / S3 rootCa) is available for users who want to trust exactly
                 one certificate instead. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
